#message("${GIT_EXECUTABLE}")
if(GIT_EXECUTABLE)
	get_filename_component(KYTY_SOURCE_DIR ${INPUT_FILE} DIRECTORY)
	execute_process(COMMAND ${GIT_EXECUTABLE} describe --tags --always
		WORKING_DIRECTORY ${KYTY_SOURCE_DIR}
		OUTPUT_VARIABLE KYTY_GIT_VERSION
		RESULT_VARIABLE KYTY_GIT_RESULT
		ERROR_QUIET)
	if(NOT KYTY_GIT_RESULT EQUAL 0)
		set(KYTY_GIT_VERSION "unknown")
	endif()
else()
	set(KYTY_GIT_VERSION "unknown")
endif()
string(STRIP "${KYTY_GIT_VERSION}" KYTY_GIT_VERSION)
configure_file(${INPUT_FILE} ${OUTPUT_FILE})
